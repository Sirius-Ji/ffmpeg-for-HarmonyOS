// 模板文件：首次克隆项目后，复制为 harmony/build-profile.json5，
// 再在 DevEco Studio 的 Project Structure → Signing Configs 里配置你自己的签名。
// build-profile.json5 已被 .gitignore 忽略，本机的证书路径和口令不会进 git。
{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // 版本号格式（DevEco 26 实测）：
        //   API ≤ 25 写 "6.0.0(20)" 这种带括号的；API ≥ 26 写 "26.0.0"。
        // 基线钉在 API 20 时改成 "6.0.0(20)" 并装好对应 SDK。
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
