harmony/entry/libs/

# ================= 签名与密钥：绝不入库 =================
*.p12
*.cer
*.p7b
*.p7s
*.pem
*.key
*.jks
*.keystore
**/signing/
**/signature/

# ================= 测试产物（rawfile 里的样例音频要保留） =================
test/ref/*.pcm
test/*.m4a
test/*.flac
test/*.opus
*.wav
harmony/entry/src/main/resources/rawfile/*.pcm

# ================= 杂项 =================
*.log
Thumbs.db
.DS_Store

# Python ����
__pycache__/
*.pyc

